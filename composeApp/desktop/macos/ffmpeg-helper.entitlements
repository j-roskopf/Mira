<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      FFmpeg is a separate executable with hardened runtime enabled. It needs its own capture
      capabilities even when macOS attributes the permission request to the responsible Mira app.
      This app is not sandboxed; App Sandbox inheritance does not apply here.
    -->
    <key>com.apple.security.device.camera</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
