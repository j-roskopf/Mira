rules_version = '2';

// Journal media. Only the owner reads or writes, and uploads are capped so a runaway client
// cannot fill the bucket: 10 minutes of 1080p at 4 Mbps is roughly 300 MB.
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/media/{entryId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 400 * 1024 * 1024
        && (
          request.resource.contentType.matches('audio/.*')
          || request.resource.contentType.matches('video/.*')
          || request.resource.contentType.matches('image/.*')
        );
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
